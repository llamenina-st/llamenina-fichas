{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "js.neutralino.llamenina",
  "version": "1.5.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": false,
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "modes": {
    "window": {
      "title": "LLA FICHA v1.5.0 — Fichas Técnicas",
      "width": 1280,
      "height": 850,
      "minWidth": 950,
      "minHeight": 650,
      "resizable": true,
      "maximize": false
    }
  },
  "cli": {
    "binaryName": "llamenina-fichas",
    "resourcesPath": "/resources/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}